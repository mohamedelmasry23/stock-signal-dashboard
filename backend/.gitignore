__pycache__/
*.pyc

# real financial data — never commit these
data/*.db

.env
.venv/
venv/

# backtest artifacts (equity/trades CSVs, summaries)
data/backtests/

# scheduled-run logs and yfinance cache
pipeline.log
data/launchd.*.log
data/pipeline_last_run.txt
data/yf_cache/

# Intraday watchlist scan output — same reason as pipeline.log: it names
# real tickers from the real universe and is regenerated on every scan.
watch.log
data/watch_last_run.txt
data/watch.launchd.out.log
data/watch.launchd.err.log

# Market data downloads (Databento bars, roll logs, any DBN/parquet cache).
# Large, re-fetchable, and metered by the byte — never commit.
#
# Written as "everything in data/, except universes/" rather than a bare
# `data/` because git cannot re-include a path inside an EXCLUDED
# DIRECTORY. `data/` would exclude the directory itself, git would never
# descend into it, and `!data/universes/` below would silently do nothing —
# so a rebuilt sp500_constituents.csv could no longer be committed.
data/*
!data/universes/

# The one database that IS committed: a scrubbed copy of real.db with no
# holdings, no account settings and no equity-sized figures, built by
# `python3 -m app.public_snapshot`. Re-included file by file (not the
# directory) so a stray .tmp or -journal next to it stays ignored.
!data/snapshot/
data/snapshot/*
!data/snapshot/dashboard.db
