# Copy to .env.local and fill in. .env.local is git-ignored; this file is
# the committed template.

# Name for the header greeting ("Good Evening <name>"). Leave unset for a
# generic "Good Evening" with no name — the right choice for a public
# demo. The name is also suppressed automatically whenever the backend
# reports demo_mode=true, so a demo deploy can't leak it either way.
VITE_USER_NAME=
